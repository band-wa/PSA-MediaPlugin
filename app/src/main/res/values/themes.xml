<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MediaPlugin" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:colorPrimary">@color/colorPrimary</item>
        <item name="android:colorAccent">@color/colorPrimaryMid</item>
        <item name="android:textColorPrimary">@color/colorOnSurface</item>
        <item name="android:textColorSecondary">@color/colorOnSurfaceMuted</item>
    </style>

    <style name="Theme.MediaPlugin.Translucent">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>
